// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  lecturer
  student
}

model Department {
  id   String @id @default(uuid())
  code String @unique
  name String @unique

  programs StudyProgram[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

model StudyProgram {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  degreeLevel String?

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  classes   Class[]
  students  Student[]
  lecturers Lecturer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("study_programs")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String
  name         String
  role         Role      @default(student)
  refreshToken String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student      Student?
  lecturer     Lecturer?
  
  @@map("users")
}

model Class {
  id        String   @id @default(uuid())
  name      String   @unique // Contoh: "TI-2021-A"

  studyProgramId String?
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)

  lecturers Lecturer[]
  students  Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("classes")
}

model Student {
  id         String   @id @default(uuid())
  nim        String   @unique
  name       String
  semester   String?
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relasi ke Kelas
  classId    String?
  class      Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)

  studyProgramId String?
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  
  // Relasi ke Dosen Wali
  lecturerId String?
  lecturer   Lecturer? @relation(fields: [lecturerId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  analyses   MotivationAnalysis[]

  @@map("students")
}

model MotivationAnalysis {
  id            String    @id @default(uuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  description   String?   // Contoh: "Catatan harian"
  transcription String    @db.Text
  prediction    String    
  confidence    Float
  probabilities Json?     
  mfcc          Json?     
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("motivation_analyses")
}

model Lecturer {
  id         String   @id @default(uuid())
  nip        String   @unique
  name       String
  department String?
  
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Relasi ke Kelas (Dosen bisa mengampu sebuah kelas)
  classId    String?
  class      Class?    @relation(fields: [classId], references: [id], onDelete: SetNull)

  studyProgramId String?
  studyProgram   StudyProgram? @relation(fields: [studyProgramId], references: [id], onDelete: SetNull)
  
  // Relasi ke Mahasiswa Perwalian
  students   Student[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@map("lecturers")
}
